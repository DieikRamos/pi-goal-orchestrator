{
  "name": "pi-goal-orchestrator",
  "version": "0.1.0",
  "description": "Companion extension for pi-goal-x: run a focused goal's work as an audited DAG of pi-subagents in small contexts.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "goal",
    "orchestrator",
    "subagents",
    "dag"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DieikRamos/pi-goal-orchestrator.git"
  },
  "homepage": "https://github.com/DieikRamos/pi-goal-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/DieikRamos/pi-goal-orchestrator/issues"
  },
  "files": [
    "extensions",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/orchestrator.ts"
    ]
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "test:all": "npm run check && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typebox": "^1.3.11",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
